{
  "name": "kunban",
  "version": "0.1.0",
  "description": "A calm desktop-native priority board for Windows.",
  "main": "dist-electron/main.js",
  "author": "Kunban contributors",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5188 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5188 electron dist-electron/electron/main.js",
    "build": "npm run build:ui && npm run build:electron",
    "build:ui": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "mcp": "tsx src/mcp/server.ts"
  },
  "build": {
    "appId": "io.kunban.desktop",
    "productName": "Kunban",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
